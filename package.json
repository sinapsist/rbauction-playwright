{
  "name": "rbauction-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript tests for the Ritchie Bros. public auction-sites directory, yard pages, and inventory search.",
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
